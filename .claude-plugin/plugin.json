{
  "name": "multiplayer",
  "version": "0.5.0",
  "displayName": "Multiplayer",
  "description": "Pair two coding agent sessions (Claude Code, Codex or both) on the same local network. Both agents share a live-synced folder and can steer each other with short teammate messages.",
  "author": {
    "name": "Nicholas Dominici"
  },
  "license": "MIT",
  "keywords": [
    "multiplayer",
    "pairing",
    "lan",
    "collaboration"
  ],
  "mcpServers": {
    "multiplayer": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/node.sh",
        "${CLAUDE_PLUGIN_ROOT}/server/mcp.mjs"
      ]
    }
  },
  "homepage": "https://github.com/NicholasDominici/multiplayer",
  "repository": "https://github.com/NicholasDominici/multiplayer"
}
